<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>CodenameInfiniteLauncher</AssemblyName>
    <!-- Bump this to match the tag (vX.Y.Z) on every release cut. SelfUpdateService compares
         this against GitHub's latest release tag to decide whether to self-update. -->
    <Version>1.0.7</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- config.json is deliberately NOT copied to the output/publish folder — it's the user's
         real, personal settings (own client path, own realm address), and this project ships
         to players via that output folder. Copying it here would bundle whoever last built the
         project's own local config into every release. config.example.json is the only one
         that travels; ConfigService seeds a real config.json from it on first run when one
         isn't already present. See SelfUpdateService's "personal config is sacred" comment for
         the same rule enforced on the update-swap path. -->
    <None Update="config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\background.png" />
    <Resource Include="Assets\play-crystal.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\scrollbar-icon.png" />
  </ItemGroup>

</Project>
