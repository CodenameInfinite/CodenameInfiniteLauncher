                                    <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0.9"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
