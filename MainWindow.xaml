<Window x:Class="CodenameInfiniteLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodenameInfinite Launcher"
        Width="900" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D22">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Background art, full-bleed behind the translucent title/bottom bars -->
        <Image Grid.Row="0" Grid.RowSpan="3" Source="Assets/background.png" Stretch="UniformToFill" IsHitTestVisible="False"/>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#000000" Opacity="0.001" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
        <Grid Grid.Row="0" Background="#59000000" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="CodenameInfinite v1.001" Foreground="#CFD2DA" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="MinimizeButton" Content="&#xE921;" Width="28" Height="24" Click="MinimizeButton_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#9A9EA8" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            <Button x:Name="CloseButton" Content="&#xE8BB;" Width="28" Height="24" Click="CloseButton_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#9A9EA8" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
        </StackPanel>

        <!-- Content / background art -->
        <Grid Grid.Row="1">
            <!-- Realm status pill -->
            <Border Background="#8C0A0B0E" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#888888" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusPillText" Text="checking realm..." Foreground="#D6D9DF" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Patch notes panel -->
            <Border Background="#8C0A0B0E" CornerRadius="6" Width="240" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,50,0,16" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Patch notes" Foreground="#F2F3F5" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="NewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#A8ACB5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- First-run overlay: shown when no client is found at ClientPath -->
            <Border x:Name="FirstRunOverlay" Background="#CC0A0B0E" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <TextBlock Text="No game client found" Foreground="#F2F3F5" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="FirstRunDetailText" Text="Download the 1.12.1 client or point the launcher at an existing install."
                               Foreground="#A8ACB5" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Button x:Name="DownloadClientButton" Content="Download client (torrent)" Height="38"
                            Background="#5DCAA5" Foreground="#04342C" FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Margin="0,0,0,10" Click="DownloadClientButton_Click"/>
                    <Button x:Name="LocateClientButton" Content="Locate existing install..." Height="34"
                            Background="Transparent" Foreground="#D6D9DF" FontSize="12" BorderBrush="#4B4F58"
                            BorderThickness="1" Click="LocateClientButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="2" Background="#73000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,0">
                <TextBlock x:Name="StatusText" Text="checking for updates..." Foreground="#C3C6CD" FontSize="11" Margin="0,0,0,5"/>
                <Grid>
                <ProgressBar x:Name="UpdateProgress" Height="3" Minimum="0" Maximum="100" Value="0"
                             Background="#1EFFFFFF" Foreground="#C88FF7" BorderThickness="0">
                    <ProgressBar.Effect>
                        <DropShadowEffect x:Name="ProgressGlow" Color="#C88FF7" ShadowDepth="0" BlurRadius="6" Opacity="0.55"/>
                    </ProgressBar.Effect>
                    <!-- Pointed hex-bar clip: StackPanel is 752px wide (900 window - 116 Play-button
                         column - 32 StackPanel margin), so the tips land exactly on the bar's own edges. -->
                    <ProgressBar.Clip>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1.5" IsClosed="True">
                                <LineSegment Point="8,0"/>
                                <LineSegment Point="744,0"/>
                                <LineSegment Point="752,1.5"/>
                                <LineSegment Point="744,3"/>
                                <LineSegment Point="8,3"/>
                            </PathFigure>
                        </PathGeometry>
                    </ProgressBar.Clip>
                    <ProgressBar.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <!-- Slow sine-eased pulse (~3s/cycle) instead of rapid linear jumps —
                                         reads as breathing rather than flashing. Slight asymmetry (the mid
                                         dip doesn't return all the way to the start value) keeps a touch of
                                         the organic feel without the fast flicker. -->
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressGlow" Storyboard.TargetProperty="BlurRadius">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="6">
                                            <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="20">
                                            <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:3.0" Value="6">
                                            <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgressGlow" Storyboard.TargetProperty="Opacity">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5">
                                            <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0">
                                            <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5">
                                            <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>

                <!-- Rising spark particles drifting off the glow bar. Each is self-contained
                     (own Loaded trigger, own Storyboard.BeginTime stagger) so they cycle
                     independently instead of pulsing in unison. -->
                <Canvas x:Name="ParticleCanvas" Height="3" IsHitTestVisible="False">
                    <Ellipse Canvas.Left="40" Canvas.Bottom="0" Width="3" Height="3" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="5" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark1T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:0.0" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark1T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-16" Duration="0:0:2.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="160" Canvas.Bottom="0" Width="2" Height="2" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark2T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:0.5" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.8"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark2T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-13" Duration="0:0:2.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="290" Canvas.Bottom="0" Width="4" Height="4" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark3T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:1.0" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.9"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark3T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-18" Duration="0:0:2.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="420" Canvas.Bottom="0" Width="3" Height="3" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="5" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark4T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
