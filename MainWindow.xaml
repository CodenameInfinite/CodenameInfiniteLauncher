                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark4T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-15" Duration="0:0:2.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="550" Canvas.Bottom="0" Width="2" Height="2" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark5T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:2.0" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.8"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark5T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-13" Duration="0:0:2.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="680" Canvas.Bottom="0" Width="3" Height="3" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="5" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark6T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:0.8" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.9"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark6T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-17" Duration="0:0:2.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Canvas.Left="100" Canvas.Bottom="0" Width="2" Height="2" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark7T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:0.25" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.8"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark7T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-12" Duration="0:0:2.0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="225" Canvas.Bottom="0" Width="3" Height="3" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="5" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark8T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:1.3" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark8T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-16" Duration="0:0:2.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="355" Canvas.Bottom="0" Width="2" Height="2" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark9T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:0.6" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.8"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark9T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-12" Duration="0:0:2.0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="485" Canvas.Bottom="0" Width="4" Height="4" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark10T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:1.9" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.9"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark10T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-19" Duration="0:0:2.7"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="615" Canvas.Bottom="0" Width="3" Height="3" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="5" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark11T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:0.1" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.3" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark11T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-15" Duration="0:0:2.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Ellipse Canvas.Left="710" Canvas.Bottom="0" Width="2" Height="2" Fill="#E6CCFF" Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#C88FF7" ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Spark12T" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:1.6" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.8"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Spark12T" Storyboard.TargetProperty="Y"
                                                          From="0" To="-12" Duration="0:0:2.0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Canvas>
                </Grid>
            </StackPanel>

            <!-- Purple crystal Play button, using the uploaded artwork (transparent PNG). Dim/flat
                 while updates are in progress, swaps to full brightness with a noisy pulsing glow
                 (same flicker language as the progress bar) once IsEnabled flips true. -->
            <Button x:Name="PlayButton" Grid.Column="1" Width="100" Height="60"
                    Margin="0,0,16,0" VerticalAlignment="Center"
                    IsEnabled="False" Click="PlayButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image x:Name="CrystalImage" Source="Assets/play-crystal.png" Stretch="Uniform" Opacity="0.4">
                                <Image.Effect>
                                    <DropShadowEffect x:Name="PlayGlow" Color="#C88FF7" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                                </Image.Effect>
                            </Image>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="CrystalImage" Property="Opacity" Value="1.0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PlayGlowStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Slow sine-eased pulse (~2.6s/cycle), same breathing language as the
                                                 progress bar's glow but a slightly different period so the two
                                                 don't lock into a synchronized flash. -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayGlow" Storyboard.TargetProperty="BlurRadius">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="8">
                                                    <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="24">
