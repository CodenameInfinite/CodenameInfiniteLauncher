<Window x:Class="CodenameInfiniteLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodenameInfinite Launcher"
        Icon="Assets/app.ico"
        Width="900" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D22">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Background art, full-bleed behind the translucent title/bottom bars -->
        <Image Grid.Row="0" Grid.RowSpan="3" Source="Assets/background.png" Stretch="UniformToFill" IsHitTestVisible="False"/>

        <!-- Accent layer: glow hotspots over existing bright art features, a shimmer sweep, and
             twinkling ambient particles. Starts invisible (Opacity=0) — code-behind fades this in
             once PlayButton.IsEnabled flips true (SetReadyToLaunch), so the art only "comes alive"
             once the game is actually ready to launch. Coordinates are in window space (0-900,
             0-600) since the background Image exactly fills the window at this aspect ratio. -->
        <Canvas x:Name="BackgroundAccents" Opacity="0" IsHitTestVisible="False">

            <!-- Glow hotspot: galaxy swirl, center-top -->
            <Ellipse Canvas.Left="405" Canvas.Top="65" Width="110" Height="110">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A6F0E0FF" Offset="0"/>
                        <GradientStop Color="#00C88FF7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.4"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="0.9"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:4.4" Value="0.4"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- Glow hotspot: green gate, right side -->
            <Ellipse Canvas.Left="715" Canvas.Top="165" Width="90" Height="90">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9C9CFFB0" Offset="0"/>
                        <GradientStop Color="#009CFFB0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard BeginTime="0:0:0.8" RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.35"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="0.85"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.8" Value="0.35"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- Glow hotspot: purple orb, lower right -->
